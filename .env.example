ZIPKIN_MEM_MAX_SPANS=

# /zipkin Basic Auth (nginx) - 비밀번호 평문이 아니라 openssl passwd -apr1 해시값을 넣는다
# GitHub Secret에는 $apr1$xxxx$yyyy 형태의 원본 해시값을 그대로 저장한다.
# CI/CD에서 .env 생성 시 작은따옴표로 감싸므로 $를 $$로 이스케이프할 필요가 없다.
ZIPKIN_UI_USER=
ZIPKIN_UI_PASSWORD_HASH=

JWT_SECRET=

TRACING_SAMPLING_PROBABILITY=

GRAFANA_ROOT_URL=

# Grafana Slack Alerting
SLACK_WEBHOOK_URL=

SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=